          "type": "string",
          "default": ""
        },
        "exact": {
          "description": "Require the whole title to match exactly.",
          "type": "boolean",
          "default": false
        },
        "timeout_ms": {
          "description": "How long to wait for the window, in ms.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 10000
