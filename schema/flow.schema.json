{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flow",
  "description": "A complete automation flow.",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Optional path/URL of the JSON schema (ignored by the engine).",
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "description": "Human-readable name of the flow.",
      "type": "string",
      "default": ""
    },
    "description": {
      "description": "What the flow does.",
      "type": "string"
    },
    "version": {
      "description": "Flow format version. Currently 1.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "default": 1
    },
    "variables": {
      "description": "Initial variables. Can be overridden at run time (`--var name=value`).",
      "type": "object",
      "additionalProperties": true
    },
    "steps": {
      "description": "Steps executed in order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Step"
      },
      "default": []
    }
  },
  "$defs": {
    "Step": {
      "description": "One step of a flow: common settings plus the action (`\"action\": \"...\"`)\nand the action's own fields, all at the same JSON level.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Unique id within the flow, used in logs.",
          "type": "string"
        },
        "enabled": {
          "description": "Disabled steps are skipped.",
          "type": "boolean"
        },
        "comment": {
          "description": "Free-text note shown in the editor.",
          "type": "string"
        },
        "on_error": {
          "description": "What to do when the step fails after all retries.",
          "$ref": "#/$defs/OnError"
        },
        "retries": {
          "description": "Extra attempts after a failure.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "retry_delay_ms": {
          "description": "Delay between retries in milliseconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "oneOf": [
        {
          "description": "Set a variable (strings are interpolated).",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "set_variable"
            }
          },
          "$ref": "#/$defs/SetVariable",
          "required": [
            "action"
          ]
        },
        {
          "description": "Add a number to a numeric variable (counters).",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "increment"
            }
          },
          "$ref": "#/$defs/Increment",
          "required": [
            "action"
          ]
        },
        {
          "description": "Write a message to the run log.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "log"
            }
          },
          "$ref": "#/$defs/Log",
          "required": [
            "action"
          ]
        },
        {
          "description": "Pause for a number of milliseconds.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "wait"
            }
          },
          "$ref": "#/$defs/Wait",
          "required": [
            "action"
          ]
        },
        {
          "description": "Run `then` steps if the condition holds, otherwise `else` steps.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "if"
            }
          },
          "$ref": "#/$defs/If",
          "required": [
            "action"
          ]
        },
        {
          "description": "Run `steps` a fixed number of times.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "repeat"
            }
          },
          "$ref": "#/$defs/Repeat",
          "required": [
            "action"
          ]
        },
        {
          "description": "Run `steps` while the condition holds (bounded by max_iterations).",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "while"
            }
          },
          "$ref": "#/$defs/While",
          "required": [
            "action"
          ]
        },
        {
          "description": "Run `steps` once per item of a list.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "for_each"
            }
          },
          "$ref": "#/$defs/ForEach",
          "required": [
            "action"
          ]
        },
        {
          "description": "Leave the innermost repeat / while / for_each loop.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "break"
            }
          },
          "$ref": "#/$defs/Break",
          "required": [
            "action"
          ]
        },
        {
          "description": "End the flow now, successfully or as a failure.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "stop"
            }
          },
          "$ref": "#/$defs/Stop",
          "required": [
            "action"
          ]
        },
        {
          "description": "Run another flow file as a sub-flow.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "run_flow"
            }
          },
          "$ref": "#/$defs/RunFlow",
          "required": [
            "action"
          ]
        },
        {
          "description": "Copy a file (to a file path or into a folder).",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "file_copy"
            }
          },
          "$ref": "#/$defs/CopyMove",
          "required": [
            "action"
          ]
        },
        {
          "description": "Move or rename a file or folder.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "file_move"
            }
          },
          "$ref": "#/$defs/CopyMove",
          "required": [
            "action"
          ]
        },
        {
          "description": "Delete file(s); wildcards allowed.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "file_delete"
            }
          },
          "$ref": "#/$defs/FileDelete",
          "required": [
            "action"
          ]
        },
        {
          "description": "Write or append text to a file (creates folders).",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "file_write"
            }
          },
          "$ref": "#/$defs/FileWrite",
          "required": [
            "action"
          ]
        },
        {
          "description": "Read a text file into a variable.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "file_read"
            }
          },
          "$ref": "#/$defs/PathToVar",
          "required": [
            "action"
          ]
        },
        {
          "description": "Store \"true\"/\"false\" depending on whether a path exists.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "file_exists"
            }
          },
          "$ref": "#/$defs/PathToVar",
          "required": [
            "action"
          ]
        },
        {
          "description": "Store name, extension, size, dates etc. of a path in an object variable.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "file_info"
            }
          },
          "$ref": "#/$defs/PathInfo",
          "required": [
            "action"
          ]
        },
        {
          "description": "Create a folder (and parents).",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "dir_create"
            }
          },
          "$ref": "#/$defs/PathOnly",
          "required": [
            "action"
          ]
        },
        {
          "description": "Delete a folder.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "dir_delete"
            }
          },
          "$ref": "#/$defs/DirDelete",
          "required": [
            "action"
          ]
        },
        {
          "description": "List files/folders matching a pattern into an array variable.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "dir_list"
            }
          },
          "$ref": "#/$defs/DirList",
          "required": [
            "action"
          ]
        },
        {
          "description": "Start a program, optionally waiting and capturing its output.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "run_program"
            }
          },
          "$ref": "#/$defs/RunProgram",
          "required": [
            "action"
          ]
        },
        {
          "description": "Terminate all processes with the given image name.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "kill_program"
            }
          },
          "$ref": "#/$defs/KillProgram",
          "required": [
            "action"
          ]
        },
        {
          "description": "Open a file, folder or URL with its default application.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "open"
            }
          },
          "$ref": "#/$defs/Open",
          "required": [
            "action"
          ]
        },
        {
          "description": "Wait for a window and bring it to the foreground.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "window_activate"
            }
          },
          "$ref": "#/$defs/WindowTarget",
          "required": [
            "action"
          ]
        },
        {
          "description": "Wait until a window with the given title exists.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "window_wait"
            }
          },
          "$ref": "#/$defs/WindowTarget",
          "required": [
            "action"
          ]
        },
        {
          "description": "Wait until no window with the given title exists.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "window_wait_close"
            }
          },
          "$ref": "#/$defs/WindowTarget",
          "required": [
            "action"
          ]
        },
        {
          "description": "Close a window (like clicking X).",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "window_close"
            }
          },
          "$ref": "#/$defs/WindowTarget",
          "required": [
            "action"
          ]
        },
        {
          "description": "Maximize, minimize or restore a window.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "window_set_state"
            }
          },
          "$ref": "#/$defs/WindowSetState",
          "required": [
            "action"
          ]
        },
        {
          "description": "Store \"true\"/\"false\" depending on whether a window exists (no waiting).",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "window_exists"
            }
          },
          "$ref": "#/$defs/WindowExists",
          "required": [
            "action"
          ]
        },
        {
          "description": "Move the mouse pointer.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "mouse_move"
            }
          },
          "$ref": "#/$defs/MouseMove",
          "required": [
            "action"
          ]
        },
        {
          "description": "Click (optionally at a position).",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "mouse_click"
            }
          },
          "$ref": "#/$defs/MouseClick",
          "required": [
            "action"
          ]
        },
        {
          "description": "Scroll the mouse wheel.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "mouse_scroll"
            }
          },
          "$ref": "#/$defs/MouseScroll",
          "required": [
            "action"
          ]
        },
        {
          "description": "Drag from one point to another.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "mouse_drag"
            }
          },
          "$ref": "#/$defs/MouseDrag",
          "required": [
            "action"
          ]
        },
        {
          "description": "Store the current pointer position.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "mouse_position"
            }
          },
          "$ref": "#/$defs/MousePosition",
          "required": [
            "action"
          ]
        },
        {
          "description": "Type text into the focused control.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "type_text"
            }
          },
          "$ref": "#/$defs/TypeText",
          "required": [
            "action"
          ]
        },
        {
          "description": "Press a key or key combination such as ctrl+s.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "key_press"
            }
          },
          "$ref": "#/$defs/KeyPress",
          "required": [
            "action"
          ]
        },
        {
          "description": "Find a UI element (UI Automation) and click it.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "ui_click"
            }
          },
          "$ref": "#/$defs/UiClick",
          "required": [
            "action"
          ]
        },
        {
          "description": "Find an input element and set its text.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "ui_set_text"
            }
          },
          "$ref": "#/$defs/UiSetText",
          "required": [
            "action"
          ]
        },
        {
          "description": "Read an element's value/text into a variable.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "ui_get_text"
            }
          },
          "$ref": "#/$defs/UiToVar",
          "required": [
            "action"
          ]
        },
        {
          "description": "Wait until a UI element exists.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "ui_wait"
            }
          },
          "$ref": "#/$defs/UiWait",
          "required": [
            "action"
          ]
        },
        {
          "description": "Store \"true\"/\"false\" depending on whether an element exists (waits up to timeout_ms).",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "ui_exists"
            }
          },
          "$ref": "#/$defs/UiToVar",
          "required": [
            "action"
          ]
        },
        {
          "description": "Put text on the clipboard.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "clipboard_set"
            }
          },
          "$ref": "#/$defs/ClipboardSet",
          "required": [
            "action"
          ]
        },
        {
          "description": "Read clipboard text into a variable.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "clipboard_get"
            }
          },
          "$ref": "#/$defs/OutputVar",
          "required": [
            "action"
          ]
        },
        {
          "description": "Save a PNG screenshot of a monitor or a window.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "screenshot"
            }
          },
          "$ref": "#/$defs/Screenshot",
          "required": [
            "action"
          ]
        }
      ]
    },
    "OnError": {
      "description": "Error handling policy for a step.",
      "oneOf": [
        {
          "description": "Abort the whole flow (default).",
          "type": "string",
          "const": "stop"
        },
        {
          "description": "Log the error and continue with the next step.",
          "type": "string",
          "const": "continue"
        }
      ]
    },
    "SetVariable": {
      "type": "object",
      "properties": {
        "name": {
          "description": "Variable name (without `${}`).",
          "type": "string",
          "default": ""
        },
        "value": {
          "description": "Value. Strings are interpolated; a string that is exactly `${x}` copies\nx's value as-is (lists stay lists). Numbers, bools, arrays and objects are stored as given.",
          "default": null
        }
      }
    },
    "Int": {
      "description": "An integer, or a string containing `${variables}` that evaluates to one.",
      "anyOf": [
        {
          "type": "integer",
          "format": "int64"
        },
        {
          "type": "string"
        }
      ]
    },
    "Increment": {
      "type": "object",
      "properties": {
        "name": {
          "description": "Numeric variable to change (missing = 0).",
          "type": "string",
          "default": ""
        },
        "by": {
          "description": "Amount to add (negative to subtract).",
          "$ref": "#/$defs/Int",
          "default": 1
        }
      }
    },
    "LogLevel": {
      "type": "string",
      "enum": [
        "info",
        "warn",
        "error"
      ]
    },
    "Log": {
      "type": "object",
      "properties": {
        "message": {
          "description": "Text to log (interpolated).",
          "type": "string",
          "default": ""
        },
        "level": {
          "description": "info, warn or error.",
          "$ref": "#/$defs/LogLevel",
          "default": "info"
        }
      }
    },
    "Wait": {
      "type": "object",
      "properties": {
        "ms": {
          "description": "Milliseconds to wait.",
          "$ref": "#/$defs/Int",
          "default": 1000
        }
      }
    },
    "Condition": {
      "description": "`left <op> right`, both sides interpolated. Numeric comparison is used when\nboth sides parse as numbers, otherwise text (case-sensitive unless `ignore_case`).",
      "type": "object",
      "properties": {
        "left": {
          "description": "Left-hand value, usually `${variable}`.",
          "type": "string",
          "default": ""
        },
        "op": {
          "description": "Comparison operator.",
          "$ref": "#/$defs/Op",
          "default": "equals"
        },
        "right": {
          "description": "Right-hand value (ignored by is_empty, not_empty, is_true, is_false, path_exists).",
          "type": "string",
          "default": ""
        },
        "ignore_case": {
          "description": "Compare text case-insensitively.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "Op": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "equals",
            "not_equals",
            "contains",
            "not_contains",
            "starts_with",
            "ends_with",
            "greater_than",
            "less_than",
            "greater_or_equal",
            "less_or_equal"
          ]
        },
        {
          "description": "`left` is empty (`right` ignored).",
          "type": "string",
          "const": "is_empty"
        },
        {
          "description": "`left` is not empty (`right` ignored).",
          "type": "string",
          "const": "not_empty"
        },
        {
          "description": "`left` is \"true\", \"yes\" or \"1\" (`right` ignored).",
          "type": "string",
          "const": "is_true"
        },
        {
          "description": "`left` is \"false\", \"no\", \"0\" or empty (`right` ignored).",
          "type": "string",
          "const": "is_false"
        },
        {
          "description": "A file or folder exists at path `left` (`right` ignored).",
          "type": "string",
          "const": "path_exists"
        },
        {
          "description": "`left` matches regex-free wildcard pattern `right` (`*` and `?`).",
          "type": "string",
          "const": "matches"
        }
      ]
    },
    "If": {
      "type": "object",
      "properties": {
        "condition": {
          "description": "The test: {left, op, right}.",
          "$ref": "#/$defs/Condition",
          "default": {
            "left": "",
            "op": "equals",
            "right": "",
            "ignore_case": false
          }
        },
        "then": {
          "description": "Steps run when the condition is true.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Step"
          },
          "default": []
        },
        "else": {
          "description": "Steps run when the condition is false.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Step"
          },
          "default": []
        }
      }
    },
    "Repeat": {
      "type": "object",
      "properties": {
        "times": {
          "description": "Number of iterations.",
          "$ref": "#/$defs/Int",
          "default": 3
        },
        "index_var": {
          "description": "Variable holding the 0-based iteration number.",
          "type": "string",
          "default": "index"
        },
        "steps": {
          "description": "Steps run each iteration.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Step"
          },
          "default": []
        }
      }
    },
    "While": {
      "type": "object",
      "properties": {
        "condition": {
          "description": "Loop while this is true (checked before each iteration).",
          "$ref": "#/$defs/Condition",
          "default": {
            "left": "",
            "op": "equals",
            "right": "",
            "ignore_case": false
          }
        },
        "max_iterations": {
          "description": "Safety limit; the step fails when reached.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 1000
        },
        "steps": {
          "description": "Steps run each iteration.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Step"
          },
          "default": []
        }
      }
    },
    "ForEach": {
      "type": "object",
      "properties": {
        "items": {
          "description": "A JSON array, or a string: `${list_var}` (an array variable) or text\nthat is split into lines.",
          "default": ""
        },
        "item_var": {
          "description": "Variable holding the current item.",
          "type": "string",
          "default": "item"
        },
        "index_var": {
          "description": "Variable holding the 0-based position.",
          "type": "string",
          "default": "index"
        },
        "steps": {
          "description": "Steps run for each item.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Step"
          },
          "default": []
        }
      }
    },
    "Break": {
      "type": "object"
    },
    "Stop": {
      "type": "object",
      "properties": {
        "message": {
          "description": "Final message of the run.",
          "type": "string",
          "default": ""
        },
        "success": {
          "description": "true = finish the flow successfully, false = fail it.",
          "type": "boolean",
          "default": true
        }
      }
    },
    "RunFlow": {
      "type": "object",
      "properties": {
        "path": {
          "description": "Path of another flow JSON file (relative paths resolve against this flow's folder).",
          "type": "string",
          "default": ""
        },
        "variables": {
          "description": "Variables passed to the sub-flow (values interpolated).",
          "type": "object",
          "additionalProperties": true,
          "default": {}
        },
        "share_variables": {
          "description": "If true, variables set by the sub-flow are copied back into this flow.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "CopyMove": {
      "type": "object",
      "properties": {
        "source": {
          "description": "File (or folder for file_move) to copy/move; wildcards allowed (`C:\\in\\*.csv`).",
          "type": "string",
          "default": ""
        },
        "destination": {
          "description": "Destination file path, or a folder: an existing folder, or any path ending in `\\` (created if missing).",
          "type": "string",
          "default": ""
        },
        "overwrite": {
          "description": "Replace existing files instead of failing.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "FileDelete": {
      "type": "object",
      "properties": {
        "path": {
          "description": "File path; may contain wildcards (`C:\\tmp\\*.log`).",
          "type": "string",
          "default": ""
        },
        "missing_ok": {
          "description": "Do not fail when nothing matches.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "FileWrite": {
      "type": "object",
      "properties": {
        "path": {
          "description": "File to write; parent folders are created.",
          "type": "string",
          "default": ""
        },
        "content": {
          "description": "Text to write (interpolated). Use ${newline} for line breaks.",
          "type": "string",
          "default": ""
        },
        "append": {
          "description": "Append instead of overwriting.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "PathToVar": {
      "type": "object",
      "properties": {
        "path": {
          "description": "File path (relative paths resolve against the flow folder).",
          "type": "string",
          "default": ""
        },
        "output_var": {
          "description": "Variable that receives the result.",
          "type": "string",
          "default": ""
        }
      }
    },
    "PathInfo": {
      "type": "object",
      "properties": {
        "path": {
          "description": "File or folder path.",
          "type": "string",
          "default": ""
        },
        "output_var": {
          "description": "Receives {name, stem, extension, parent, size, is_dir, exists, modified}.",
          "type": "string",
          "default": ""
        }
      }
    },
    "PathOnly": {
      "type": "object",
      "properties": {
        "path": {
          "description": "Folder path (relative paths resolve against the flow folder).",
          "type": "string",
          "default": ""
        }
      }
    },
    "DirDelete": {
      "type": "object",
      "properties": {
        "path": {
          "description": "Folder to delete.",
          "type": "string",
          "default": ""
        },
        "recursive": {
          "description": "Delete contents too. Without it only empty folders are removed.",
          "type": "boolean",
          "default": false
        },
        "missing_ok": {
          "description": "Do not fail when the folder does not exist.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "DirList": {
      "type": "object",
      "properties": {
        "path": {
          "description": "Folder to list.",
          "type": "string",
          "default": ""
        },
        "pattern": {
          "description": "Wildcard pattern, e.g. `*.txt`.",
          "type": "string",
          "default": "*"
        },
        "recursive": {
          "description": "Include sub-folders.",
          "type": "boolean",
          "default": false
        },
        "include_files": {
          "description": "Include files in the result.",
          "type": "boolean",
          "default": true
        },
        "include_dirs": {
          "description": "Include folders in the result.",
          "type": "boolean",
          "default": false
        },
        "output_var": {
          "description": "Receives an array of full paths, sorted.",
          "type": "string",
          "default": "files"
        }
      }
    },
    "RunProgram": {
      "type": "object",
      "properties": {
        "program": {
          "description": "Executable path or name on PATH (e.g. `notepad.exe`).",
          "type": "string",
          "default": ""
        },
        "args": {
          "description": "Command-line arguments, one per item (interpolated).",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "working_dir": {
          "description": "Folder to start in (empty = current).",
          "type": "string",
          "default": ""
        },
        "wait": {
          "description": "Wait for the program to exit.",
          "type": "boolean",
          "default": false
        },
        "timeout_ms": {
          "description": "When waiting: fail after this many ms (0 = no limit).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "output_var": {
          "description": "When waiting: variable receiving stdout.",
          "type": "string",
          "default": ""
        },
        "exit_code_var": {
          "description": "When waiting: variable receiving the exit code.",
          "type": "string",
          "default": ""
        },
        "check_exit_code": {
          "description": "When waiting: fail if the exit code is not 0.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "KillProgram": {
      "type": "object",
      "properties": {
        "name": {
          "description": "Process image name, e.g. `notepad.exe`.",
          "type": "string",
          "default": ""
        },
        "missing_ok": {
          "description": "Do not fail when no such process is running.",
          "type": "boolean",
          "default": false
        }
      }
