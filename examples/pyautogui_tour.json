{
  "$schema": "../schema/flow.schema.json",
  "name": "PyAutoGUI-style tour",
  "description": "Screen size, eased mouse movement, pixel colour, region screenshot, then finds that screenshot on screen again with image search and reports the result in a message box. Push the mouse into a screen corner or press Ctrl+Alt+Q to abort at any time.",
  "version": 1,
  "settings": {
    "key_delay_ms": 100,
    "input_pause_ms": 100,
    "step_delay_ms": 0,
    "mouse_move_ms": 400,
    "failsafe": true,
    "abort_hotkey": "ctrl+alt+q"
  },
  "variables": {
    "snap": "${flow_dir}\\output\\tour_snip.png"
  },
  "steps": [
    { "id": "size", "action": "screen_size", "width_var": "w", "height_var": "h" },
    { "id": "where", "action": "mouse_position", "x_var": "start_x", "y_var": "start_y" },
    { "id": "to_target", "action": "mouse_move", "x": 640, "y": 300, "duration_ms": 600, "tween": "ease_in_out_quad" },
    { "id": "wiggle", "action": "mouse_move", "x": 120, "y": 0, "relative": true, "duration_ms": 500, "tween": "ease_out_bounce" },
    { "id": "back", "action": "mouse_move", "x": "${start_x}", "y": "${start_y}", "tween": "ease_out_cubic" },
    { "id": "pixel", "action": "pixel_get", "x": 200, "y": 200, "output_var": "color" },
    { "id": "snap", "action": "screenshot", "path": "${snap}", "region": { "x": 100, "y": 100, "width": 160, "height": 90 } },
    { "id": "find", "action": "image_find", "image": "${snap}", "confidence": 0.95, "found_var": "found", "x_var": "fx", "y_var": "fy" },
    {
      "id": "report",
      "action": "if",
      "condition": { "left": "${found}", "op": "is_true" },
      "then": [
        { "id": "ok", "action": "log", "message": "Screen ${w}x${h}; pixel (200,200) = ${color}; snip found again at (${fx}, ${fy}) - expected (180, 145)" }
      ],
      "else": [
        { "id": "miss", "action": "log", "level": "warn", "message": "snip not found (the screen changed between capture and search?)" }
      ]
    },
    { "id": "ask", "action": "message_box", "title": "AutoFlowMate tour", "text": "Screen ${w} x ${h}\nPixel (200,200): ${color}\nImage found again: ${found} at (${fx}, ${fy})", "buttons": "ok", "icon": "info", "output_var": "answer" }
  ]
}
